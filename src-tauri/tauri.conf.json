{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TTSBard",
  "version": "1.1.0",
  "identifier": "com.al.ttsbard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TTSBard",
        "width": 800,
        "height": 630,
        "minWidth": 755,
        "minHeight": 540,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "create": false
      },
      {
        "label": "soundpanel",
        "url": "src-soundpanel/index.html",
        "title": "",
        "width": 640,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "create": false
      },
      {
        "label": "playback-control",
        "url": "src-playback/index.html",
        "title": "Управление",
        "width": 350,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "create": false
      },
      {
        "label": "ocr-selection",
        "url": "src-ocr-selection/index.html",
        "title": "",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "create": false
      },
      {
        "label": "settings-recovery",
        "url": "src-settings-recovery/index.html",
        "title": "TTSBard",
        "width": 640,
        "height": 520,
        "minWidth": 460,
        "minHeight": 400,
        "minimizable": false,
        "maximizable": false,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "theme": "Light",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/dict/LICENSE.txt": "third-party/licenses/hunspell-ru-LICENSE.txt",
      "resources/espeak-ng-data": "espeak-ng-data",
      "locales": "locales",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "vendor/signalsmith-stretch/LICENSE.txt": "third-party/licenses/signalsmith-stretch-LICENSE.txt",
      "vendor/signalsmith-linear/LICENSE.txt": "third-party/licenses/signalsmith-linear-LICENSE.txt"
    }
  }
}
